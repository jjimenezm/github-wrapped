# dependencies
node_modules/
.pnpm-store/

# builds
dist/
coverage/
.angular/
*.tsbuildinfo

# env and secrets (only .env.example is versioned)
.env
.env.*
!.env.example

# local data (dev FILES_DIR for PNG/MP4 renders); anchored so it never hides source folders
/.data/

# tooling
.superpowers/
# local design-hook cache and ignore list, anywhere in the tree
.impeccable/
# HyperFrames writes its preview and render state next to each composition
.hyperframes/
.DS_Store
*.log

# Playwright output
test-results/
playwright-report/

# browser bundles built from a package (packages/art/build/art.iife.js)
/packages/*/build/
# vendored at build time from node_modules into the video composition (GSAP, the art bundle)
/apps/renderer/compositions/wrap/vendor/
