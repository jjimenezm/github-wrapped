{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    // Callbacks passed to page.evaluate() run in the browser.
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["*.ts", "fixtures/**/*.ts"]
}
