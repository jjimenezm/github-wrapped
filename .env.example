# api
# Fine-grained token, public repositories read-only, from a dedicated account.
GITHUB_SERVER_TOKEN=
# Tests and local development only; the api refuses to start with it in production.
GITHUB_FIXTURES_DIR=
# Required in production. Without it (outside production) the api uses an in-memory store.
REDIS_URL=
# Lookups allowed per IP and window (seconds).
RATE_LIMIT_PREVIEW_MAX=20
RATE_LIMIT_PREVIEW_WINDOW_SECONDS=600
PORT=3000
NODE_ENV=development