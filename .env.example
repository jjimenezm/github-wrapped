# api
# Outside production every value has a local default; production must set all of them.
PORT=3000
NODE_ENV=development

# GitHub data: fine-grained token, public repositories read-only, from a dedicated account.
GITHUB_SERVER_TOKEN=
# Tests and local development only; the api refuses to start with it in production.
GITHUB_FIXTURES_DIR=

# GitHub login: the OAuth app (identity only, no scopes). Not needed in fixture mode.
# Callback URL to register in the app: <API_BASE_URL>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Signs sessions and the OAuth state; at least 32 characters (e.g. `openssl rand -hex 32`).
# Outside production, a random one is generated on each start.
SESSION_SECRET=

# Web origin printed in QR codes and links, and where the login sends people back (https in production).
PUBLIC_BASE_URL=http://localhost:4200
# Where the api answers, for the OAuth callback; defaults to PUBLIC_BASE_URL in production.
API_BASE_URL=http://localhost:3000

# Postgres for the published wraps. Without it (outside production) they live in memory.
# Local: infra/docker-compose.dev.yml started with POSTGRES_PORT=55432.
DATABASE_URL=postgresql://wrapped:wrapped@127.0.0.1:55432/wrapped
# Redis for the cache, the rate limits and the render queues. Without it (outside production)
# the api uses memory and nothing renders. Local: REDIS_PORT=56379.
REDIS_URL=redis://127.0.0.1:56379
# Shared volume for each wrap's PNG and MP4 files: the renderer writes, the api serves.
# The api falls back to a temporary folder outside production; the renderer always needs it.
FILES_DIR=

# renderer (also reads DATABASE_URL, REDIS_URL, FILES_DIR and PUBLIC_BASE_URL above)
# Image renders at the same time; each takes ~0.2 s and little memory.
RENDER_IMAGES_CONCURRENCY=1

# Rate limits per IP and window (seconds).
RATE_LIMIT_PREVIEW_MAX=20
RATE_LIMIT_PREVIEW_WINDOW_SECONDS=600
# GitHub login, publishing and regenerating.
RATE_LIMIT_PUBLISH_MAX=10
RATE_LIMIT_PUBLISH_WINDOW_SECONDS=3600
# Proxies in front of the api that append to X-Forwarded-For: 1 for Traefik alone, 2 with Cloudflare too.
TRUST_PROXY_HOPS=1

# web: where the server-rendered page reaches the api inside the server (unset in development).
API_INTERNAL_URL=
# Set by the images: NG_TRUST_PROXY_HEADERS (web) and REQUIRE_FILES_VOLUME=true (renderer).
