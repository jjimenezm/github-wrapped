{
  "name": "@wrapped/art",
  "version": "0.0.0",
  "private": true,
  "description": "Generative card art (Huella, Cordillera, Constelación) as pure SVG functions",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./build/art.iife.js": "./build/art.iife.js"
  },
  "scripts": {
    "clean": "rm -rf dist build",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && pnpm build:browser",
    "build:browser": "esbuild src/browser.ts --bundle --format=iife --global-name=WrappedArt --target=es2022 --minify --legal-comments=inline --outfile=build/art.iife.js",
    "dev": "pnpm run \"/^watch:/\"",
    "watch:cjs": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "watch:esm": "tsc -p tsconfig.esm.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "jest",
    "sample": "tsx scripts/sample.ts"
  },
  "dependencies": {
    "@wrapped/shared": "workspace:*",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "geist": "^1.9.0",
    "jest": "^30.0.0",
    "jsqr": "^1.4.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    }
  }
}
